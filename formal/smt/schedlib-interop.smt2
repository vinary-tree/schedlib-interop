(set-logic QF_LIA)
(set-option :produce-models true)

(declare-const phase Int)
(declare-const actual_bytes Int)
(declare-const declared_bytes Int)
(declare-const max_bytes Int)
(declare-const work Int)
(declare-const work_limit Int)
(declare-const tasks Int)
(declare-const events Int)
(declare-const receipts Int)
(declare-const cursor Int)
(declare-const payload Int)
(declare-const header Int)

(assert (>= actual_bytes 0))
(assert (>= declared_bytes 0))
(assert (>= max_bytes 0))
(assert (>= work 0))
(assert (>= work_limit 0))
(assert (>= tasks 0))
(assert (>= events 0))
(assert (>= receipts 0))
(assert (>= cursor 0))
(assert (>= payload 0))
(assert (>= header 0))

(echo "Q01_STATE_DOMAIN_IS_CLOSED")
(push)
(assert (and (>= phase 0) (<= phase 8) (or (< phase 0) (> phase 8))))
(check-sat)
(pop)

(echo "Q02_FIXED_WIDTH_IS_PLATFORM_INDEPENDENT")
(push)
(assert (not (= (+ 112 payload) (+ payload 112))))
(check-sat)
(pop)

(echo "Q03_HEADER_MISMATCH_IS_REJECTED")
(push)
(assert (= header 0))
(assert (= header 1))
(check-sat)
(pop)

(echo "Q04_TRAILING_BYTES_ARE_REJECTED")
(push)
(assert (= declared_bytes actual_bytes))
(assert (> actual_bytes declared_bytes))
(check-sat)
(pop)

(echo "Q05_OVERFLOW_IS_REJECTED")
(push)
(assert (<= actual_bytes max_bytes))
(assert (> actual_bytes max_bytes))
(check-sat)
(pop)

(echo "Q06_OVERSIZE_BYTES_HAVE_NO_ALLOCATION")
(push)
(declare-const allocated_06 Bool)
(assert (= allocated_06 (<= actual_bytes max_bytes)))
(assert (> actual_bytes max_bytes))
(assert allocated_06)
(check-sat)
(pop)

(echo "Q07_COUNT_LIMITS_HAVE_NO_ALLOCATION")
(push)
(declare-const max_tasks_07 Int)
(declare-const allocated_07 Bool)
(assert (= allocated_07 (<= tasks max_tasks_07)))
(assert (> tasks max_tasks_07))
(assert allocated_07)
(check-sat)
(pop)

(echo "Q08_WORK_BOUND_IS_MONOTONE")
(push)
(assert (<= work work_limit))
(assert (> work work_limit))
(check-sat)
(pop)

(echo "Q09_CANCELLED_RESULT_IS_UNPUBLISHED")
(push)
(declare-const cancelled_09 Bool)
(declare-const published_09 Bool)
(assert (=> cancelled_09 (not published_09)))
(assert cancelled_09)
(assert published_09)
(check-sat)
(pop)

(echo "Q10_EXACT_RESERVE_FOLLOWS_ADMISSION")
(push)
(declare-const capacity_10 Int)
(assert (= capacity_10 tasks))
(assert (not (= capacity_10 tasks)))
(check-sat)
(pop)

(echo "Q11_FOREIGN_CODEC_IS_REJECTED")
(push)
(declare-const expected_codec_11 Int)
(declare-const actual_codec_11 Int)
(declare-const admitted_11 Bool)
(assert (= admitted_11 (= expected_codec_11 actual_codec_11)))
(assert (not (= expected_codec_11 actual_codec_11)))
(assert admitted_11)
(check-sat)
(pop)

(echo "Q12_KEY_REENCODE_IS_EXACT")
(push)
(declare-const key_bytes_12 Int)
(declare-const reencoded_12 Int)
(assert (= key_bytes_12 reencoded_12))
(assert (not (= key_bytes_12 reencoded_12)))
(check-sat)
(pop)

(echo "Q13_KEY_COLLISION_IS_REJECTED")
(push)
(declare-const key_left_13 Int)
(declare-const key_right_13 Int)
(declare-const encoded_left_13 Int)
(declare-const encoded_right_13 Int)
(assert (=> (= encoded_left_13 encoded_right_13) (= key_left_13 key_right_13)))
(assert (= encoded_left_13 encoded_right_13))
(assert (not (= key_left_13 key_right_13)))
(check-sat)
(pop)

(echo "Q14_PLAN_FIELD_CHANGE_BREAKS_EQUALITY")
(push)
(declare-const plan_field_14 Int)
(declare-const changed_field_14 Int)
(assert (not (= plan_field_14 changed_field_14)))
(assert (= plan_field_14 changed_field_14))
(check-sat)
(pop)

(echo "Q15_PLAN_ROUND_TRIP_IS_EXACT")
(push)
(declare-const plan_15 Int)
(declare-const decoded_15 Int)
(assert (= decoded_15 plan_15))
(assert (not (= decoded_15 plan_15)))
(check-sat)
(pop)

(echo "Q16_CANONICAL_REENCODE_IS_UNIQUE")
(push)
(declare-const bytes_16 Int)
(declare-const reencoded_16 Int)
(assert (= bytes_16 reencoded_16))
(assert (not (= bytes_16 reencoded_16)))
(check-sat)
(pop)

(echo "Q17_DEPENDENCY_ENDPOINT_IS_IN_RANGE")
(push)
(declare-const endpoint_17 Int)
(assert (>= endpoint_17 0))
(assert (< endpoint_17 tasks))
(assert (>= endpoint_17 tasks))
(check-sat)
(pop)

(echo "Q18_DEPENDENCIES_ARE_STRICTLY_ORDERED")
(push)
(declare-const left_18 Int)
(declare-const right_18 Int)
(assert (< left_18 right_18))
(assert (>= left_18 right_18))
(check-sat)
(pop)

(echo "Q19_EFFECTS_ARE_STRICTLY_ORDERED")
(push)
(declare-const left_19 Int)
(declare-const right_19 Int)
(assert (< left_19 right_19))
(assert (= left_19 right_19))
(check-sat)
(pop)

(echo "Q20_INVALID_UTF8_IS_REJECTED")
(push)
(declare-const utf8_valid_20 Bool)
(declare-const admitted_20 Bool)
(assert (= admitted_20 utf8_valid_20))
(assert (not utf8_valid_20))
(assert admitted_20)
(check-sat)
(pop)

(echo "Q21_DIGEST_DOMAINS_DIFFER")
(push)
(assert (= 1 2))
(check-sat)
(pop)

(echo "Q22_DIGEST_OMISSION_CHANGES_CONTROL")
(push)
(declare-const complete_digest_22 Int)
(declare-const omitted_digest_22 Int)
(assert (not (= complete_digest_22 omitted_digest_22)))
(assert (= complete_digest_22 omitted_digest_22))
(check-sat)
(pop)

(echo "Q23_DIGEST_MISMATCH_HAS_NO_RESULT")
(push)
(declare-const digest_match_23 Bool)
(declare-const result_23 Bool)
(assert (=> (not digest_match_23) (not result_23)))
(assert (not digest_match_23))
(assert result_23)
(check-sat)
(pop)

(echo "Q24_FOREIGN_PLAN_IS_REJECTED")
(push)
(declare-const plan_equal_24 Bool)
(declare-const checkpoint_24 Bool)
(assert (=> checkpoint_24 plan_equal_24))
(assert (not plan_equal_24))
(assert checkpoint_24)
(check-sat)
(pop)

(echo "Q25_DIGEST_MATCH_CANNOT_HIDE_PLAN_MISMATCH")
(push)
(declare-const plan_equal_25 Bool)
(declare-const accepted_25 Bool)
(assert (=> accepted_25 plan_equal_25))
(assert (not plan_equal_25))
(assert accepted_25)
(check-sat)
(pop)

(echo "Q26_CHECKPOINT_COUNTS_ARE_BOUNDED")
(push)
(assert (<= events (+ tasks 1)))
(assert (> events (+ tasks 1)))
(check-sat)
(pop)

(echo "Q27_SUCCESS_EVENTS_FORM_PREFIX")
(push)
(assert (<= cursor events))
(assert (> cursor events))
(check-sat)
(pop)

(echo "Q28_TERMINAL_EVENT_IS_UNIQUE_LAST")
(push)
(declare-const terminal_index_28 Int)
(assert (= terminal_index_28 (- events 1)))
(assert (< terminal_index_28 (- events 1)))
(check-sat)
(pop)

(echo "Q29_CURSOR_IS_DERIVED")
(push)
(declare-const success_prefix_29 Int)
(assert (= cursor success_prefix_29))
(assert (not (= cursor success_prefix_29)))
(check-sat)
(pop)

(echo "Q30_RECEIPTS_FORM_PREFIX")
(push)
(assert (<= receipts events))
(assert (> receipts events))
(check-sat)
(pop)

(echo "Q31_UNKNOWN_EVENT_KIND_IS_REJECTED")
(push)
(declare-const event_kind_31 Int)
(assert (and (>= event_kind_31 1) (<= event_kind_31 6)))
(assert (or (< event_kind_31 1) (> event_kind_31 6)))
(check-sat)
(pop)

(echo "Q32_CHECKPOINT_HAS_NO_PAYLOAD_FIELD")
(push)
(declare-const checkpoint_fields_32 Int)
(assert (= checkpoint_fields_32 4))
(assert (> checkpoint_fields_32 4))
(check-sat)
(pop)

(echo "Q33_CHECKPOINT_ROUND_TRIP_IS_EXACT")
(push)
(declare-const checkpoint_33 Int)
(declare-const roundtrip_33 Int)
(assert (= checkpoint_33 roundtrip_33))
(assert (not (= checkpoint_33 roundtrip_33)))
(check-sat)
(pop)

(echo "Q34_REPLAY_OBSERVATION_MATCHES_SERIAL")
(push)
(declare-const replay_34 Int)
(declare-const serial_34 Int)
(assert (= replay_34 serial_34))
(assert (not (= replay_34 serial_34)))
(check-sat)
(pop)

(echo "Q35_REPLAY_BYTES_ARE_STABLE")
(push)
(declare-const before_35 Int)
(declare-const after_35 Int)
(assert (= before_35 after_35))
(assert (not (= before_35 after_35)))
(check-sat)
(pop)

(echo "Q36_STACK_MEASURE_IS_CONSTANT")
(push)
(declare-const stack_before_36 Int)
(declare-const stack_after_36 Int)
(assert (= stack_before_36 stack_after_36))
(assert (> stack_after_36 stack_before_36))
(check-sat)
(pop)

(echo "Q37_WORK_AND_HEAP_ARE_LINEAR")
(push)
(declare-const items_37 Int)
(declare-const bytes_37 Int)
(declare-const measured_37 Int)
(assert (= measured_37 (+ items_37 bytes_37 8)))
(assert (> measured_37 (+ items_37 bytes_37 8)))
(check-sat)
(pop)

(echo "Q38_CONCURRENT_RESULTS_ARE_EQUAL")
(push)
(declare-const first_38 Int)
(declare-const second_38 Int)
(assert (= first_38 second_38))
(assert (not (= first_38 second_38)))
(check-sat)
(pop)

(echo "Q39_MALFORMED_INPUT_HAS_NO_PUBLICATION")
(push)
(declare-const malformed_39 Bool)
(declare-const published_39 Bool)
(assert (=> malformed_39 (not published_39)))
(assert malformed_39)
(assert published_39)
(check-sat)
(pop)

(echo "CONTROL_VALID_COUNTS_EXIST")
(push)
(assert (= tasks 2))
(assert (= events 3))
(assert (= receipts 2))
(assert (<= events (+ tasks 1)))
(assert (<= receipts events))
(check-sat)
(pop)

(echo "CONTROL_OVERSIZE_INPUT_EXISTS")
(push)
(assert (= actual_bytes 4))
(assert (= max_bytes 3))
(assert (> actual_bytes max_bytes))
(check-sat)
(pop)

(echo "CONTROL_CANCELLATION_THRESHOLD_EXISTS")
(push)
(assert (= cursor 2))
(assert (= events 3))
(assert (< cursor events))
(check-sat)
(pop)
